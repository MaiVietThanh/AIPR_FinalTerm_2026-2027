# Copy file này thành .env rồi điền key thật. KHÔNG commit .env.

# LLM (Groq, API dạng OpenAI)
LLM_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_JSON_MODE=0            # gpt-oss: 0 | qwen/qwen3.8-27b: 1
LLM_REASONING_EFFORT=low   # gpt-oss: low | qwen: none
LLM_NATIVE_TOOLS=1         # gpt-oss: 1 (function calling gốc) | qwen: 0

# Embedding cho RAG (Jina)
JINA_API_KEY=
